{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@myproject/core": ["library/packages/core/src/index.ts"],
      "@myproject/foundations/*": ["library/packages/foundations/*"],
      "@myproject/icons": ["library/packages/icons/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "pages/**/*.ts", "pages/**/*.tsx"],
  "exclude": ["node_modules", "library"]
}
